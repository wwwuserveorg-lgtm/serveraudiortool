# Copy this file to .streamlit/secrets.toml and fill in your real connection string.
# .streamlit/secrets.toml is already gitignored - never commit real credentials.
#
# On Streamlit Community Cloud, don't upload this file at all: paste the same
# key/value into the app's Settings -> Secrets panel instead.

DATABASE_URL = "postgresql://user:password@host:5432/dbname?sslmode=require"
